{
  "manifest_version": 3,
  "name": "Conduit Bridge",
  "version": "0.1.0",
  "description": "Bridge for ChatGPT to Conduit local runtime",
  "action": {
    "default_title": "Conduit Bridge",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:3333/*",
    "http://localhost:3333/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
